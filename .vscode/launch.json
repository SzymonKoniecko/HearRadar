{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Rust",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin", "${workspaceFolderBasename}"],
        "filter": {
          "name": "${workspaceFolderBasename}",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"],
      "terminal": "integrated"
    },
    {
      "name": "Debug testy Rust",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--no-run"],
        "filter": {
          "kind": "test"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"],
      "terminal": "integrated"
    }
  ]
}
